# .gitattributes — chuan xuong dong + tieng Viet co dau
# Quy tac: moi file van ban dung LF, giu nguyen tieng Viet UTF-8

* text=auto eol=lf

# Maven wrapper
/mvnw text eol=lf
*.cmd text eol=crlf

# Ma nguon Java
*.java text eol=lf diff=java encoding=utf-8
*.xml text eol=lf encoding=utf-8
*.properties text eol=lf encoding=utf-8
*.yml text eol=lf encoding=utf-8
*.yaml text eol=lf encoding=utf-8
*.md text eol=lf encoding=utf-8
*.json text eol=lf encoding=utf-8
*.html text eol=lf encoding=utf-8
*.css text eol=lf encoding=utf-8
*.js text eol=lf encoding=utf-8

# Anh / file nhi phan khong doi xuong dong
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.war binary
